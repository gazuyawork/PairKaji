rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function billingKeys() {
      return [
        'plan',
        'premiumType',
        'subscriptionStatus',
        'subscriptionId',
        'googlePlayProductId',
        'googlePlayPurchaseToken',
        'googlePlayExpiryTime',
        'googlePlaySubscriptionState',
        'googlePlayLinkedAt',
        'stripeCustomerId'
      ];
    }

    function noBillingOnCreate() {
      return !request.resource.data.keys().hasAny(billingKeys());
    }

    function billingUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys());
    }

    function isTaskMember() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.keys().hasAny(['userIds']) && request.auth.uid in resource.data.userIds)
      );
    }

    function isTaskMemberOnWrite() {
      return signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.keys().hasAny(['userIds']) && request.auth.uid in request.resource.data.userIds)
      );
    }

    // 課金ロック。Admin SDK のみ書き込み可
    match /playPurchaseLocks/{id} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && noBillingOnCreate();
      allow update: if signedIn() && billingUnchanged() && (
        isSelf(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedTasksCleaned'])
      );
      allow delete: if isSelf(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /pairs/{pairId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.userIds ||
        resource.data.userAId == request.auth.uid ||
        resource.data.emailB == request.auth.token.email
      );
      allow create: if signedIn() &&
        request.resource.data.userAId == request.auth.uid &&
        request.auth.uid in request.resource.data.userIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.userIds ||
        resource.data.userAId == request.auth.uid ||
        resource.data.emailB == request.auth.token.email
      );
      allow delete: if signedIn() && (
        request.auth.uid in resource.data.userIds ||
        resource.data.userAId == request.auth.uid ||
        resource.data.emailB == request.auth.token.email
      );
    }

    match /tasks/{taskId} {
      allow read: if isTaskMember();
      allow create: if isTaskMemberOnWrite();
      allow update: if isTaskMember() && isTaskMemberOnWrite();
      allow delete: if isTaskMember();

      match /todos/{todoId} {
        allow read, write: if isTaskMember();
      }
    }

    match /taskCompletions/{id} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.userIds
      );
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.auth.uid in request.resource.data.userIds
      );
      allow update, delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.userIds
      );
    }

    match /taskLikes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        request.auth.uid in request.resource.data.likedBy ||
        request.auth.uid in request.resource.data.participants
      );
      allow update: if signedIn();
      allow delete: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        request.auth.uid in resource.data.participants
      );
    }

    // ポイントはペア相手のドキュメントも更新する
    match /points/{uid} {
      allow read, write: if signedIn();
      match /history/{hid} {
        allow read, write: if signedIn();
      }
    }

    match /savings/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /user_settings/{uid} {
      allow read, write: if isSelf(uid);
    }

    match /user_configs/{uid}/{document=**} {
      allow read, write: if isSelf(uid);
    }

    match /contacts/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /task_split_logs/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /push_subscriptions/{id} {
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /app_users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }
  }
}
